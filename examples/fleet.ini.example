# rulescope fleet inventory. Values in [DEFAULT] apply to every device.
# Each section is one device; 'vdom' may list several VDOMs (one report each).
# Firmware advisories, palette and lifecycle dates are command-line options of 'rulescope fleet':
#   rulescope fleet --inventory fleet.ini --out site --advisories online --palette harbor

# TLS: a FortiGate usually has a self-signed admin certificate. Pin it per device with pin_sha256
# (the SHA-256 fingerprint of that certificate), or set ca_file once the certificate comes from your CA.
#   openssl s_client -connect 192.0.2.1:443 </dev/null 2>/dev/null | openssl x509 -noout -fingerprint -sha256
# 'insecure = yes' switches verification off: anyone on the path can then read the API token.

[DEFAULT]
token_file = /etc/rulescope/token
timeout = 30
; Certificate check, one of:
;   pin_sha256 = <fingerprint>   per device, for the self-signed FortiGate certificate (rulescope cert --host ...)
;   ca_file = /etc/rulescope/ca.pem   when the FortiGates have certificates from your CA
;   insecure = yes   lab only: anyone on the network path can capture the token

[HQ-FW]
host = 192.0.2.1
pin_sha256 = PASTE_FINGERPRINT_FROM_rulescope_cert
label = Headquarters
group = Core
vdom = root
not_wan = port10, QinQ-V10 ; default route points to an upstream internal network, not the internet

[Branch-North]
host = 192.0.2.21:8443  ; admin HTTPS on a non-default port
pin_sha256 = PASTE_FINGERPRINT_FROM_rulescope_cert
label = Branch North
group = Branches
token_env = BRANCH_TOKEN ; token from an environment variable instead of the default file

[Customer-X-offline]
config = /audits/customer-x/FGT_backup.conf
usage = /audits/customer-x/hits.csv
usage_since = 2026-08-01
label = Customer X (offline)
group = Customers
